# BoxPilot environment — EXAMPLE ONLY. Copy to .env (or export) and fill
# in your own values. Never commit a filled-in copy.

# Schwab Developer Portal app credentials
SCHWAB_CLIENT_ID=
SCHWAB_APP_SECRET=

# OAuth refresh token from the Schwab authorization flow.
#
# Schwab rotates this token on every refresh and invalidates the old
# one. BoxPilot therefore persists the rotated value to a local token
# store and prefers it over this variable, so the token below only
# needs to be valid once. If the token store is ever deleted or the
# persisted token is revoked, set a fresh one here.
SCHWAB_REFRESH_TOKEN=

# Optional: where the rotated OAuth refresh token is persisted.
# Default: ~/.config/boxpilot/schwab_refresh_token (mode 0600).
# The file holds a credential — never commit it.
SCHWAB_TOKEN_STORE=

# Optional: alert recipient for watch mode (E.164 digits, e.g. 14155550123).
# Overrides watch.whatsapp.recipient in the config file.
WHATSAPP_RECIPIENT=
